{
    "manifest_version": 3,
    "name": "Face Authentication",
    "version": "1.0",
    "description": "Face verification extension",
    "background" : {
      "service_worker":"background.js"
    },
    "permissions": [
      "activeTab",
      "storage",
      "webNavigation",
      "scripting"
    ],
    "host_permissions": [
      "http://localhost:8000/*",
      "ws://localhost:8000/*"
    ],
    "action": {
      "default_popup": "popup.html"
    }
  }